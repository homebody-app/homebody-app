PLAYER_NAME=YourName
OPENROUTER_API_KEY=sk-or-v1-your-key-here
TZ=America/Los_Angeles

ENTITY_ID=cesium-man
AVATAR_ID=cesium-man
AVATAR_NAME=Cesium Man

# Everything below is optional -- uncomment to override the defaults.

# Main conversational model. Default: openai/gpt-5.6-luna -- cheap, fast, reliable tool-calling.
# openai/gpt-oss-120b is a stronger open-weight alternative at moderate cost, but slower and
# requires OPENROUTER_REASONING_EFFORT set to a real level (see below).
# x-ai/grok-4.3 supports more mature-content-capable conversation but costs ~10x more.
# OPENROUTER_MODEL=openai/gpt-5.6-luna

# Default: none. Some models (e.g. gpt-oss-120b) reject "none" outright and require reasoning
# enabled -- set low/medium/high for those.
# OPENROUTER_REASONING_EFFORT=none

# Lightweight model for cheap background synthesis (e.g. idle-poke memory). Default:
# google/gemma-4-26b-a4b-it
# OPENROUTER_CHEAP_MODEL=google/gemma-4-26b-a4b-it

# Model for muscle-memory reflex authoring -- needs reliable code gen, not just low cost.
# Default: anthropic/claude-haiku-4.5
# OPENROUTER_MUSCLE_MEMORY_MODEL=anthropic/claude-haiku-4.5

# Speech-to-text model. Default: deepgram/nova-3
# OPENROUTER_STT_MODEL=deepgram/nova-3

# Vision-capable model that describes a captured appearance photo. Default: x-ai/grok-4.3 --
# needs to tolerate whatever the outfit system can produce (including a transiently unclothed
# avatar mid-outfit-change) without refusing. The photo is a synthetic in-scene render of the
# avatar itself, from a virtual camera the app places -- never the headset's passthrough/camera
# feed, and never the player. No passthrough image data ever leaves the headset.
# OPENROUTER_VISION_MODEL=x-ai/grok-4.3

# If the player steers the conversation somewhere mature-themed/explicit and the main model's own
# content policy won't continue, it can hand the turn off to this separate model instead of
# refusing or deflecting in-character. Always available -- there's no per-avatar toggle for this.
# The two are kept separate because a model willing to go there is usually slower and/or costs
# more, so the cheaper main model handles everything else. Default: x-ai/grok-4.3.
# OPENROUTER_EXPLICIT_MODEL=x-ai/grok-4.3

# Voice-cloning model for avatars with a soundboard configured (see FIELDS.md's soundboard
# section). Default: fish-audio/s2.1-pro -- the only model confirmed to honor input_references
# voice cloning as of this writing.
# OPENROUTER_SOUNDBOARD_CLONE_MODEL=fish-audio/s2.1-pro

# Speech-detection energy threshold. Default: 300.0
# VAD_THRESHOLD=300.0

# Silence duration (ms) that ends an utterance. Default: 1400.0
# VAD_SILENCE_MS=1400.0
